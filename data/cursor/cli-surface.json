    "tool": "cursor",
    "name": "&",
    "display_name": "Hand off to a Cloud Agent",
    "type": "prefix-command",
    "category": "agents",
    "role": "Cloud handoff",
    "description": "Prepend & to a message to push the conversation to a Cloud Agent so it keeps running after you step away.",
    "syntax": [
      "&<message>"
    ],
    "examples": [
      {
        "command": "&finish the migration and open a pull request when the tests pass",
        "explanation": "Hand the current conversation to a Cloud Agent that continues without you.",
        "level": "practical"
      }
    ],
    "when_to_use": [
      "Use when a long-running task should continue after you close the terminal."
    ],
    "when_not_to_use": [
      "Do not use for work that must stay on your machine, because the conversation moves to a Cloud Agent."
    ],
