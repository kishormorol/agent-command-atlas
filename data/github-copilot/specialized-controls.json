    "display_name": "Prevent machine sleep",
    "type": "slash-command",
    "aliases": [
      "/caffeinate"
    ],
    "category": "system",
    "role": "Sleep prevention",
    "description": "Prevent the machine from sleeping for the active session, while the agent is busy, or for a specified duration.",
    "syntax": [
      "/keep-alive [on|off|busy|duration]"
    ],
    "examples": [
      {
        "command": "/keep-alive busy",
        "explanation": "Prevent sleep only while the agent is busy.",
        "level": "minimal"
      },
      {
        "command": "/keep-alive 2h",
        "explanation": "Keep the machine awake during a two-hour unattended validation run.",
        "level": "practical"
      }
    ],
    "when_to_use": [
      "Use for a long local task that would be interrupted if the machine sleeps."
    ],
    "when_not_to_use": [
      "Turn it off when continued wakefulness is no longer needed."
