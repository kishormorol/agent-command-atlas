    "role": "Prompt refinement",
    "description": "Rewrite roughly composed text into a clearer prompt for review before it is sent.",
    "syntax": [
      "/refine <text>",
      "Ctrl+X then /refine"
    ],
    "examples": [
      {
        "command": "/refine fix auth maybe race tests",
        "explanation": "Rewrite rough text into a clear prompt for review.",
        "level": "minimal"
      },
      {
        "command": "Ctrl+X then /refine",
        "explanation": "Refine the text already in the input box, which is useful after voice dictation.",
        "level": "practical"
      }
    ],
    "when_to_use": [
      "Use when a draft prompt is ambiguous or was entered quickly by speech."
