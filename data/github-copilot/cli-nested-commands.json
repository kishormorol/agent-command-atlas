[
  {
    "id": "github-copilot.cli-subcommand.mcp-add",
    "tool": "github-copilot",
    "name": "copilot mcp add",
    "display_name": "Add an MCP server",
    "type": "cli-subcommand",
    "parent_id": "github-copilot.cli-subcommand.mcp",
    "category": "mcp",
    "role": "MCP configuration",
    "description": "Add an MCP server to the user configuration at ~/.copilot/mcp-config.json. Give a stdio command after --, or pass a URL with --transport http or sse.",
    "syntax": [
      "copilot mcp add [options] <name> -- <command> [args...]",
      "copilot mcp add --transport <http|sse> <name> <url>"
    ],
    "examples": [
      {
        "command": "copilot mcp add my-server -- npx -y @org/my-mcp",
        "explanation": "Add a local stdio server.",
        "level": "minimal"
      },
      {
        "command": "copilot mcp add --transport http api-server https://mcp.example.com",
        "explanation": "Add a remote streamable HTTP server.",
        "level": "practical"
      },
      {
        "command": "copilot mcp add db --env PGURL=postgres://localhost/dev --tools 'query,schema' -- npx -y @org/pg-mcp",
        "explanation": "Add a stdio server with an environment variable and a tool filter.",
        "level": "workflow"
      }
    ],
    "when_not_to_use": [
      "Read a server's command, URL, environment, and exposed tools before adding it; MCP tools act outside the repository."
    ],
    "related_commands": [
      "github-copilot.cli-flag.transport",
      "github-copilot.cli-subcommand.mcp-list"
    ],
    "capabilities": [
      "mcp.manage"
    ],
    "maturity": "stable",
    "availability": {
      "channels": [
        "cli"
      ],
      "conditions": []
    },
    "sources": [
      {
        "url": "https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-command-reference",
        "kind": "official-docs"
      }
    ],
    "verification": {
      "status": "officially-documented",
      "last_verified": "2026-09-05",
      "tested_version": "1.0.83",
      "verified_by": [
        "official-docs",
        "manual-test"
      ]
    }
  },
