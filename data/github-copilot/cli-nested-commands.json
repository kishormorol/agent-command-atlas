    "id": "github-copilot.cli-subcommand.plugin-install",
    "tool": "github-copilot",
    "name": "copilot plugin install",
    "display_name": "Install a plugin",
    "type": "cli-subcommand",
    "parent_id": "github-copilot.cli-subcommand.plugin",
    "category": "plugins",
    "role": "Plugin installation",
    "description": "Install a plugin from a marketplace specification, a GitHub repository or subdirectory, a Git URL, or a local path. The copilot plugins install form also installs a single skill with --skill.",
    "syntax": [
      "copilot plugin install <specification>"
    ],
    "examples": [
      {
        "command": "copilot plugin install spark@copilot-plugins",
        "explanation": "Install from a registered marketplace.",
        "level": "minimal"
      },
      {
        "command": "copilot plugin install owner/repo:path/to/plugin",
        "explanation": "Install from a subdirectory of a GitHub repository.",
        "level": "practical"
      },
      {
        "command": "copilot plugins install --skill --scope project ./my-skill/SKILL.md",
        "explanation": "Install one skill into the repository's .github/skills directory.",
        "level": "workflow"
      }
    ],
    "when_not_to_use": [
      "A plugin runs with your session's reach; install only from sources you trust."
    ],
