  {
    "id": "codex.cli-subcommand.app-server",
    "tool": "codex",
    "name": "codex app-server",
    "display_name": "Start the Codex app server",
    "type": "cli-subcommand",
    "parent_id": "codex.cli-command.launch",
    "category": "agents",
    "role": "Protocol server",
    "description": "Launch the local Codex app server over JSONL standard I/O, WebSocket, or a Unix socket for client integrations and debugging.",
    "syntax": [
      "codex app-server [--listen <transport>]"
    ],
    "examples": [
      {
        "command": "codex app-server --listen stdio://",
        "explanation": "Start the app server with its default JSONL standard-I/O transport.",
        "level": "minimal"
      },
      {
        "command": "codex app-server --listen ws://127.0.0.1:4500",
        "explanation": "Expose a local WebSocket endpoint for an app-server client.",
        "level": "practical"
      }
    ],
    "when_to_use": [
      "Use when developing or debugging a client that speaks the Codex app-server protocol."
    ],
    "when_not_to_use": [
      "Do not expose an unencrypted ws:// listener beyond localhost or a trusted tunnel."
    ],
    "maturity": "experimental",
    "availability": {
      "channels": [
        "cli"
      ],
      "conditions": [
        "Primarily intended for development and debugging and may change."
      ]
    },
    "sources": [
      {
        "url": "https://learn.chatgpt.com/docs/developer-commands?surface=cli",
        "kind": "official-docs"
      }
