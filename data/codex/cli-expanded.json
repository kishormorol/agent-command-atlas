    "display_name": "Apply a cloud-task diff",
    "type": "cli-subcommand",
    "parent_id": "codex.cli-command.launch",
    "category": "git",
    "role": "Cloud change application",
    "description": "Apply the most recent diff from a Codex cloud chat to the local repository with git apply.",
    "syntax": [
      "codex apply <task-id>"
    ],
    "examples": [
      {
        "command": "codex apply task_123",
        "explanation": "Bring an authenticated cloud task's completed patch into the checked-out repository for local review and testing.",
        "level": "practical"
      }
    ],
    "when_to_use": [
      "Use after a cloud task has produced a diff that you want to inspect locally."
    ],
    "when_not_to_use": [
