  {
    "id": "muse-code.environment-variable.codex-home",
    "tool": "muse-code",
    "name": "CODEX_HOME",
    "display_name": "Codex home for skill discovery",
    "type": "environment-variable",
    "category": "skills",
    "role": "Skill discovery",
    "description": "Point Muse Code at the Codex skill directory it discovers at $CODEX_HOME/skills.",
    "syntax": [
      "CODEX_HOME=<path>"
    ],
    "when_to_use": [
      "Share one Codex skill library with Muse Code."
    ],
    "when_not_to_use": [
      "A user preference and rollout gate can disable foreign personal skill roots."
    ],
    "related_commands": [
