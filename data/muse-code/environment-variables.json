[
  {
    "id": "muse-code.environment-variable.meta-api-key",
    "tool": "muse-code",
    "name": "META_API_KEY",
    "display_name": "Meta API key",
    "type": "environment-variable",
    "category": "authentication",
    "role": "API authentication",
    "description": "Provide a Meta API key so Muse Code can authenticate without the browser sign-in flow.",
    "syntax": [
      "META_API_KEY=<key>"
    ],
    "when_to_use": [
      "Authenticate in CI, a script, or a Meta Managed Account that cannot use browser sign-in."
    ],
    "when_not_to_use": [
      "muse logout does not unset an exported META_API_KEY; remove it from your shell or secret store separately."
    ],
    "related_commands": [
      "muse-code.cli-subcommand.auth-set",
      "muse-code.cli-subcommand.logout"
    ],
    "capabilities": [
      "auth.login"
    ],
    "maturity": "stable",
    "availability": {
      "channels": [
        "cli",
        "interactive"
      ],
      "conditions": []
    },
    "sources": [
      {
        "url": "https://dev.meta.ai/docs/muse-code/auth",
        "kind": "official-docs"
      }
    ],
    "verification": {
      "status": "officially-documented",
      "last_verified": "2026-09-05",
      "tested_version": null,
      "verified_by": [
        "official-docs"
      ]
    },
    "notes": [
      "Muse Code uses META_API_KEY if set, then a stored key, and only then a stored browser session."
    ]
  },
  {
