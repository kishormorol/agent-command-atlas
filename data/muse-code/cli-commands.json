    ],
    "examples": [
      {
        "command": "muse resume",
        "explanation": "Open the interactive resume picker for retained sessions.",
        "level": "minimal"
      },
      {
        "command": "muse resume <fork-id>",
        "explanation": "Continue a session branched earlier with /fork.",
        "level": "practical"
      }
    ],
    "when_to_use": [
      "Continue an interrupted or forked session with its event log replayed."
    ],
    "when_not_to_use": [
      "Use muse exec --session-id to continue a job non-interactively; muse resume always opens the UI."
    ],
