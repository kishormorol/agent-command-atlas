[
  {
    "id": "muse-code.cli-command.launch",
    "tool": "muse-code",
    "name": "muse",
    "display_name": "Start Muse Code",
    "type": "cli-command",
    "category": "session",
    "role": "Session launch",
    "description": "Launch an interactive Muse Code session in the current project directory.",
    "syntax": [
      "muse",
      "muse [prompt]"
    ],
    "examples": [
      {
        "command": "muse",
        "explanation": "Start an interactive session in the current directory.",
        "level": "minimal"
      },
      {
        "command": "cd /path/to/your/project && muse",
        "explanation": "Open a session against a specific project checkout.",
        "level": "practical"
      }
    ],
    "when_to_use": [
      "Work with the agent interactively, with approvals and live status."
    ],
    "when_not_to_use": [
      "Use muse exec for scripted or CI runs that must complete without a terminal UI."
    ],
    "related_commands": [
      "muse-code.cli-subcommand.exec",
      "muse-code.cli-subcommand.resume"
    ],
    "maturity": "stable",
    "availability": {
      "channels": [
        "cli"
      ],
      "conditions": [
        "First run asks whether to trust the workspace and prompts for authentication."
      ],
      "platforms": [
        "macos",
        "linux"
      ]
    },
    "sources": [
      {
        "url": "https://dev.meta.ai/docs/muse-code",
        "kind": "official-docs"
      },
      {
        "url": "https://dev.meta.ai/docs/muse-code/auth",
        "kind": "official-docs"
      }
    ],
    "verification": {
      "status": "officially-documented",
      "last_verified": "2026-09-05",
      "tested_version": null,
      "verified_by": [
        "official-docs"
      ]
    }
  },
  {
    "id": "muse-code.cli-subcommand.exec",
    "tool": "muse-code",
    "name": "muse exec",
    "display_name": "Run headlessly",
    "type": "cli-subcommand",
    "parent_id": "muse-code.cli-command.launch",
    "category": "session",
    "role": "Headless execution",
    "description": "Run one prompt to completion without a terminal UI, for scripts and CI pipelines.",
    "syntax": [
      "muse exec \"<prompt>\"",
      "muse exec --prompt-file <path>",
      "muse exec --session-id <uuid> \"<prompt>\""
    ],
    "examples": [
      {
        "command": "muse exec \"Update the changelog for the latest release and run the tests.\"",
        "explanation": "Run a single prompt to completion and print the result to stdout.",
        "level": "minimal"
      },
      {
        "command": "muse exec --json \"Refactor the auth module and run the tests.\"",
        "explanation": "Emit JSONL events on stdout for a pipeline to consume.",
        "level": "practical"
      },
      {
        "command": "META_API_KEY=\"$MUSE_KEY\" muse exec --disable-approval \"Run the test suite and summarize failures.\"",
        "explanation": "Run unattended in CI with an API key and no approval prompts, keeping the sandbox on.",
        "level": "workflow"
      }
    ],
    "when_to_use": [
      "Drive the agent from a script, a job, or a CI pipeline."
    ],
    "when_not_to_use": [
      "Do not rely on the exit code to judge whether the work is correct; it reports only how the run ended."
    ],
    "related_commands": [
      "muse-code.cli-flag.json",
      "muse-code.cli-flag.prompt-file",
      "muse-code.cli-flag.max-model-steps"
    ],
    "maturity": "stable",
    "availability": {
      "channels": [
        "cli"
      ],
      "conditions": [
        "A headless run cannot answer an interactive approval prompt; choose an approval policy that completes unattended."
      ]
    },
    "sources": [
      {
        "url": "https://dev.meta.ai/docs/muse-code",
        "kind": "official-docs"
      },
      {
        "url": "https://dev.meta.ai/docs/muse-code/extending",
        "kind": "official-docs"
      }
    ],
    "verification": {
      "status": "officially-documented",
      "last_verified": "2026-09-05",
      "tested_version": null,
      "verified_by": [
        "official-docs"
      ]
    },
    "notes": [
      "Exit codes report how the run ended: 0 when the turn completes, 1 on failure or cancellation, 2 for a usage error, and 130 or 143 on SIGINT or SIGTERM."
    ]
  },
