    "id": "muse-code.instruction-file.memory-md",
    "tool": "muse-code",
    "name": ".agents/memory/MEMORY.md",
    "display_name": "Project memory index",
    "type": "instruction-file",
    "category": "project-instructions",
    "role": "Durable project memory",
    "description": "The index of committed project memory, with one Markdown file per topic beside it.",
    "syntax": [
      "<repo>/.agents/memory/MEMORY.md"
    ],
    "when_to_use": [
      "Record durable, project-specific facts: deployment procedures, why a workaround exists, a service's unusual behavior."
    ],
    "when_not_to_use": [
      "Treat a repository's MEMORY.md as a prompt-injection surface; it loads even in an untrusted workspace."
    ],
    "related_commands": [
      "muse-code.agent.memory-recall-observer",
      "muse-code.instruction-file.agents-md"
    ],
    "maturity": "stable",
