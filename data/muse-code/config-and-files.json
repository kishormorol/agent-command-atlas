[
  {
    "id": "muse-code.config-file.user-settings",
    "tool": "muse-code",
    "name": "~/.config/muse/settings.json",
    "display_name": "User settings",
    "type": "config-file",
    "category": "configuration",
    "role": "User configuration",
    "description": "User settings for model defaults, terminal UI, tools, MCP servers, hooks, runtime capabilities, and telemetry.",
    "syntax": [
      "~/.config/muse/settings.json"
    ],
    "when_to_use": [
      "Set machine-wide defaults you do not want to repeat per session."
    ],
    "when_not_to_use": [
      "A missing file is fine; create it only when you have something to set."
    ],
    "related_commands": [
      "muse-code.config-option.schema-version",
      "muse-code.slash-command.settings"
    ],
    "capabilities": [
      "config.inspect"
    ],
    "maturity": "stable",
    "availability": {
      "channels": [
        "interactive",
        "cli"
      ],
      "conditions": []
    },
    "sources": [
      {
        "url": "https://dev.meta.ai/docs/muse-code/configuration",
        "kind": "official-docs"
      }
    ],
    "verification": {
      "status": "officially-documented",
      "last_verified": "2026-09-05",
      "tested_version": null,
      "verified_by": [
        "official-docs"
      ]
    },
    "notes": [
      "The file must set \"schema_version\": 1. Omitting the key fails every command at startup with malformed settings file."
    ]
  },
  {
    "id": "muse-code.config-file.project-hooks",
    "tool": "muse-code",
    "name": ".muse/hooks.json",
    "display_name": "Project hooks file",
    "type": "config-file",
    "category": "hooks",
    "role": "Project hook configuration",
    "description": "Hooks committed to a repository at the project root.",
    "syntax": [
      "<project-root>/.muse/hooks.json"
    ],
    "when_to_use": [
      "Share lifecycle automation with everyone who clones the repository."
    ],
    "when_not_to_use": [
      "Only add hooks whose commands you have read; a hook runs through your shell outside the sandbox and approval."
    ],
    "related_commands": [
      "muse-code.config-option.hooks",
      "muse-code.config-option.managed-hooks-path",
      "muse-code.permission.workspace-trust"
    ],
    "capabilities": [
      "hooks.configure"
    ],
    "maturity": "stable",
    "availability": {
      "channels": [
        "interactive",
        "cli"
      ],
      "conditions": []
    },
    "sources": [
      {
        "url": "https://dev.meta.ai/docs/muse-code/extending",
        "kind": "official-docs"
      }
    ],
    "verification": {
      "status": "officially-documented",
      "last_verified": "2026-09-05",
      "tested_version": null,
      "verified_by": [
        "official-docs"
      ]
    },
    "notes": [
      "Project hooks run only after you trust the project folder, and take effect as soon as you trust it since 0.2.1.",
      "A malformed project or managed hook file contributes no handlers from that source and produces a startup warning."
    ]
  },
  {
    "id": "muse-code.instruction-file.agents-md",
    "tool": "muse-code",
    "name": "AGENTS.md",
    "display_name": "Project instructions",
    "type": "instruction-file",
    "category": "project-instructions",
    "role": "Hierarchical instructions",
    "description": "The project's agent rules, discovered from the workspace root up to the nearest .git boundary.",
    "syntax": [
      "AGENTS.md"
    ],
    "when_to_use": [
      "Record conventions the agent should follow in this repository."
    ],
    "when_not_to_use": [
      "Project rules load only after you trust the workspace."
    ],
    "related_commands": [
      "muse-code.cli-subcommand.init",
      "muse-code.instruction-file.claude-md",
      "muse-code.permission.workspace-trust"
    ],
    "capabilities": [
      "instructions.initialize"
    ],
    "maturity": "stable",
    "availability": {
      "channels": [
        "interactive",
        "cli"
      ],
      "conditions": []
    },
    "sources": [
      {
        "url": "https://dev.meta.ai/docs/muse-code/configuration",
        "kind": "official-docs"
      }
    ],
    "verification": {
      "status": "officially-documented",
      "last_verified": "2026-09-05",
      "tested_version": null,
      "verified_by": [
        "official-docs"
      ]
    },
    "notes": [
      "At each directory level Muse Code checks AGENTS.md, CLAUDE.md, .agents/AGENTS.md, then .claude/CLAUDE.md, and the first existing file wins for that level.",
      "Project rules win over user rules, and among project files the deeper file wins."
    ]
  },
