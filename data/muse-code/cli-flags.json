  {
    "id": "muse-code.cli-flag.reasoning-effort",
    "tool": "muse-code",
    "name": "--reasoning-effort",
    "display_name": "Set reasoning effort",
    "type": "cli-flag",
    "category": "models",
    "role": "Reasoning depth",
    "description": "Trade latency for depth with none, minimal, low, medium, high, xhigh, or ultra. The default is high.",
    "syntax": [
      "muse --reasoning-effort <none|minimal|low|medium|high|xhigh|ultra>"
    ],
    "examples": [
      {
        "command": "muse --reasoning-effort medium",
        "explanation": "Lower reasoning depth for a faster session.",
        "level": "minimal"
      },
      {
        "command": "muse exec --reasoning-effort xhigh \"Audit this module for race conditions.\"",
        "explanation": "Use the premium-precision tier for a hard headless task.",
        "level": "practical"
      }
    ],
    "when_to_use": [
      "Match reasoning depth to the difficulty of the task."
    ],
    "related_commands": [
      "muse-code.slash-command.effort"
    ],
    "maturity": "stable",
    "availability": {
      "channels": [
        "cli"
      ],
      "conditions": [
        "The Meta provider does not accept none; other providers can support it."
      ]
    },
    "sources": [
      {
        "url": "https://dev.meta.ai/docs/muse-code/configuration",
        "kind": "official-docs"
      }
    ],
    "verification": {
      "status": "officially-documented",
      "last_verified": "2026-09-05",
      "tested_version": null,
      "verified_by": [
        "official-docs"
      ]
    },
    "notes": [
      "ultra is a client-side setting that maps to each provider's highest supported tier and can make Muse Code delegate more aggressively."
    ]
  },
