    "display_name": "Select the model",
    "type": "cli-flag",
    "category": "models",
    "role": "Model selection",
    "description": "Choose the model for the run. The default model is muse-spark-1.2.",
    "syntax": [
      "muse --model <id>",
      "muse exec --model <id> \"<prompt>\""
    ],
    "examples": [
