    "id": "muse-code.cli-flag.disable-sandbox",
    "tool": "muse-code",
    "name": "--disable-sandbox",
    "display_name": "Disable the sandbox",
    "type": "cli-flag",
    "category": "permissions",
    "role": "Sandbox opt-out",
    "description": "Keep approval, but run shell commands outside the OS sandbox.",
    "syntax": [
      "muse --disable-sandbox"
    ],
    "examples": [
      {
        "command": "muse --disable-sandbox",
        "explanation": "Keep approval prompts while removing OS containment.",
        "level": "minimal"
      }
    ],
    "when_to_use": [
      "Run on a host where the OS sandbox cannot be enforced and you accept the loss of containment."
    ],
    "when_not_to_use": [
      "Avoid it on a workstation with real credentials; it also lets write_file and edit_file write anywhere on the filesystem."
    ],
    "related_commands": [
      "muse-code.cli-flag.sandbox-network"
    ],
    "capabilities": [
      "permissions.sandbox"
    ],
    "maturity": "stable",
    "availability": {
      "channels": [
        "cli"
      ],
      "conditions": []
    },
    "sources": [
      {
        "url": "https://dev.meta.ai/docs/muse-code/permissions",
        "kind": "official-docs"
      },
      {
        "url": "https://dev.meta.ai/docs/muse-code/configuration",
        "kind": "official-docs"
      }
    ],
    "verification": {
      "status": "officially-documented",
      "last_verified": "2026-09-05",
      "tested_version": null,
      "verified_by": [
        "official-docs"
      ]
    },
    "notes": [
      "It removes workspace confinement from the file tools and forces the network to full egress."
    ]
